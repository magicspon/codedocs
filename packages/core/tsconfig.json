{
  "extends": "../../tsconfig.json",
  "compilerOptions": {
    // TypeScript 7 does not auto-discover `node_modules/@types` from a package
    // directory the way TS 6 did, so the Node globals are named explicitly.
    "types": ["node"]
  },
  "include": ["src", "test"],
  // The fixture is analysis input, not code this project compiles.
  "exclude": ["test/fixtures"]
}
