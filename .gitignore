# Vitest's coverage output: the HTML report and the lcov file are both derived
# from a run anyone can repeat.
coverage

# Playwright's own run artefacts. The fixture store under `apps/e2e/tests/mocks`
# is deliberately *not* here: those files are the answer the tests assert on, and
# a fixture nobody can review is the failure this package exists to prevent.
test-results
playwright-report
blob-report
.playwright

# graphify's derived and machine-local output. `graph.json`, `manifest.json`,
# `GRAPH_REPORT.md` and the curated `.graphify_labels.json` are deliberately
# *not* here: AGENTS.md tells agents to query the graph when `graph.json`
# exists, so a fresh clone that has to rebuild first is a graph nobody uses.
graphify-out/cache/
graphify-out/graph.html
graphify-out/cost.json
graphify-out/.graphify_python
graphify-out/.graphify_root
# Pipeline scratch, deleted by the rebuild's own cleanup step. Committing these
# is how a stale chunk from an earlier run gets merged back into a later graph.
graphify-out/.graphify_ast.json
graphify-out/.graphify_analysis.json
graphify-out/.graphify_detect.json
graphify-out/.graphify_extract.json
graphify-out/.graphify_incremental.json
graphify-out/.graphify_semantic.json
graphify-out/.graphify_old.json
graphify-out/.graphify_uncached.txt
graphify-out/.graphify_chunk_*.json
# Dated snapshots of the previous graph, written on every rebuild.
graphify-out/[0-9][0-9][0-9][0-9]-[0-9][0-9]-[0-9][0-9]/

# Vendored fixture repos, cloned with full history so change-impact and
# cross-commit behaviour have real renames to run against. Never committed:
# they belong to their own upstreams, and one of them is a ~1GB monorepo.
repos

# Throwaway spike code lives on its own `spike/*` branches, never on main. The
# directory is deliberately *not* ignored — the branch has to be able to commit
# it — this note only records where it belongs.
