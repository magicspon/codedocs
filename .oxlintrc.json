{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["import", "typescript", "unicorn"],
  "categories": {
    "correctness": "error"
  },
  "options": {
    "typeAware": true
  },
  "env": {
    "builtin": true
  },
  "ignorePatterns": [
    "**/build/**",
    "**/coverage/**",
    "**/dist/**",
    "**/snap/**",
    "**/vite.config.*.timestamp-*.*",
    "graphify-out/**"
  ],
  "rules": {},
  "overrides": [
    {
      "files": ["**/*.{js,ts,tsx}"],
      "env": {
        "es2020": true
      },
      "rules": {}
    }
  ]
}
