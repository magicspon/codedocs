{
  // Its own project, like code-art, because the root config has no JSX setting.
  "extends": "../../tsconfig.json",
  "compilerOptions": {
    "jsx": "react-jsx",
    // A private app that never emits a `.d.ts`, and the router's registered
    // type is inferred and cannot be spelled out.
    "isolatedDeclarations": false,
    "declaration": false,
    "types": ["vite/client", "node"]
  },
  "include": ["src", "test", "vite.config.ts", "vitest.config.ts"],
  "exclude": []
}
