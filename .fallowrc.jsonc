{
  // This file is JSONC: fallow reads these comments; generic JSON tools may not.
  "$schema": "https://raw.githubusercontent.com/fallow-rs/fallow/main/schema.json",

  // Every published entry point. Anything not reachable from one of these is
  // genuinely dead — which is the question worth asking in a library repo.
  "entry": [],

  // Read by a tool rather than imported by anything. `commitlint.config.js` has
  // a fallow plugin that knows to look for it; nano-staged does not, so without
  // this line the pre-commit config reads as a dead file. The changeset script
  // is spelled out in `renovate.json`'s `postUpgradeTasks` and in the workflow's
  // `RENOVATE_ALLOWED_COMMANDS`, neither of which is an import.
  // Run by hand, never imported: `node bench/run.ts` and the two scripts beside
  // it are roots of their own. Without this the whole benchmark reads as dead.
  // `tsdown.config.ts` is read by tsdown when `pnpm build` runs, and is the file
  // that decides what the published package contains.
  "dynamicallyLoaded": [
    "nano-staged.js",
    "scripts/renovate-changeset.mjs",
    "bench/run.ts",
    "bench/report.ts",
    "bench/freeze-cases.ts",
    "scripts/no-network.ts",
    "packages/cli/tsdown.config.ts"
  ],

  // `packages/core/test/fixtures/specifiers` exists to prove the sweep reads a
  // dynamic `import()` that resolves to nothing, so this specifier is the
  // fixture working rather than a broken path.
  "ignoreUnresolvedImports": ["./not-here"],

  // Declared at the root so pnpm links the `codedocs` binary into
  // `node_modules/.bin`, which is a use fallow cannot see: nothing imports it,
  // and nothing should.
  "ignoreDependencies": ["@codedocs/cli"],

  "ignorePatterns": [
    "**/.next/**",
    "**/build/**",
    "**/coverage/**",
    "**/dist/**",
    "repos/**",
    // Written by `msw init`, not by us. Every finding in it is a report about
    // MSW's code that nobody here may act on.
    "**/mockServiceWorker.js",
    "**/snap/**",
    "**/storybook-static/**",
    "**/vite.config.*.timestamp-*.*",
    "graphify-out/**"
  ],

  "duplicates": {
    // Hide small-N clones; focus on widespread copy-paste worth refactoring.
    "minOccurrences": 4
  },

  "rules": {
    "unused-dependencies": "warn"
  }
}
